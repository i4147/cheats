# cargo-clean
# Remove the target directory to clean build artifacts.
# Remove the entire target directory to clean all build artifacts
cargo clean
# Clean build artifacts for a specific target (e.g., i686-unknown-linux-gnu)
cargo clean --target i686-unknown-linux-gnu
# Use with --release to clean artifacts built with the --release flag
cargo clean --release
# Clean build artifacts for a specific package within a workspace
cargo clean -p package_name
# Explain using with verbose to show more output (if useful)
cargo clean -v
# Perform clean operation in a specific directory (if the cargo project is in another folder)
cargo clean --manifest-path /path/to/Cargo.toml
 tldr:cargo-clean
# cargo clean
# Remove generated artifacts in the `target` directory.
# More information: <https://doc.rust-lang.org/cargo/commands/cargo-clean.html>.
# Remove the entire `target` directory:
cargo clean
# Remove documentation artifacts (the `target/doc` directory):
cargo clean --doc
# Remove release artifacts (the `target/release` directory):
cargo clean --release
# Remove artifacts in the directory of the given profile (in this case, `target/debug`):
cargo clean --profile dev
