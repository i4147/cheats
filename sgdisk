# sgdisk
# Command-line GUID partition table (GPT) manipulator for Linux and Unix
# convert an MBR partition table to GPT, use sgdisk
sgdisk -g /dev/sda
# convert GPT to MBR use the m option.
# it is not possible to convert more than four partitions from GPT to MBR
sgdisk -m /dev/sda
# Sort GPT partitions
# when a new partition is created in the space between two partitions
# or a partition is deleted
sgdisk -s /dev/sda
# Create a binary backup consisting of the protective MBR, the main GPT header,
# the backup GPT header, and one copy of the partition table
sgdisk -b=sgdisk-sda.bak
# Restore GPT/MBR backup:
sgdisk -l=sgdisk-sda.bak
# Clone partition layout of '/dev/sda' to another drive '/dev/sdc'
sgdisk -R=/dev/sdc /dev/sda
# Randomize GUIDs (after cloning)
sgdisk -G /dev/sdc
# Display basic GPT partition summary data for a device:
sudo sgdisk --print /dev/sdX
# Wipe both GPT and MBR data structures from a device (destroys all partition information):
sudo sgdisk --zap-all /dev/sdX
# Convert a GPT disk to MBR format using up to four partitions:
sudo sgdisk --gpttombr 1:2:3:4 /dev/sdX
# Delete a partition entry by number (data in sectors remains untouched):
sudo sgdisk --delete 1 /dev/sdX
# Save the current in-memory GPT data (protective MBR, headers, and table) to a binary backup file:
sudo sgdisk --backup /path/to/backup.gpt /dev/sdX
# Load GPT data from a backup file (restoring from a non-original disk is not recommended):
sudo sgdisk --load-backup /path/to/backup.gpt /dev/sdX
# Verify GPT structures for CRC errors, mismatches, or inconsistencies:
sudo sgdisk --verify /dev/sdX
