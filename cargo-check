# cargo-check
# Check the current package for errors without producing a binary.
# Check the current package for errors
cargo check
# Check a specific package within a workspace
cargo check -p package_name
# Check with all features enabled
cargo check --all-features
# Check with no default features
cargo check --no-default-features
# Check with only specific features enabled
cargo check --features feature1,feature2
# Check in release mode
cargo check --release
# Check with verbose output
cargo check --verbose
# Check targeting a specific platform
cargo check --target target_triple
# Check and use a custom target directory
cargo check --target-dir custom_dir
# Check with specific rust flags
RUSTFLAGS="--flag" cargo check
 tldr:cargo-check
# cargo check
# Check a local package and all of its dependencies for errors.
# More information: <https://doc.rust-lang.org/cargo/commands/cargo-check.html>.
# Check the current package:
cargo [c|check]
# Check all tests:
cargo [c|check] --tests
# Check the integration tests in `tests/integration_test1.rs`:
cargo [c|check] --test integration_test1
# Check the current package with the features `feature1` and `feature2`:
cargo [c|check] [-F|--features] feature1,feature2
# Check the current package with default features disabled:
cargo [c|check] --no-default-features
