# look
# Look for lines in sorted file (Mac OS X)
# Look for lines beginning with the given prefix.
look prefix file
# Look for lines, case-insensitively.
look -f prefix file
 tldr:look
# look
# Look for lines in sorted file.
# More information: <https://manned.org/look>.
# Look for lines which begins with the given prefix:
look prefix path/to/file
# Look for lines ignoring case:
look --ignore-case prefix path/to/file
# Note: The lines in the file must be sorted.
# See also: `grep`, `sort`.
