# cargo-build
# Compile the current package.
# Compile the current package in release mode
cargo build --release
# Compile the current package for a specific target
cargo build --target x86_64-unknown-linux-gnu
# Compile the current package with a specific feature enabled
cargo build --features feature_name
# Compile the current package and display verbose output
cargo build --verbose
# Compile all packages in the workspace
cargo build --workspace
# Compile the current package without default features
cargo build --no-default-features
# Compile the current package with all features enabled
cargo build --all-features
# Compile the current package using a different configuration profile
cargo build --profile custom_profile_name
# Compile the current package but don't actually build it (check for errors)
cargo build --check
 tldr:cargo-build
# cargo build
# Compile a local package and all of its dependencies.
# More information: <https://doc.rust-lang.org/cargo/commands/cargo-build.html>.
# Build the package or packages defined by the `Cargo.toml` manifest file in the local path:
cargo build
# Build artifacts in release mode, with optimizations:
cargo build --release
# Require that `Cargo.lock` is up to date:
cargo build --locked
# Build all packages in the workspace:
cargo build --workspace
# Build a specific package:
cargo build --package package
# Build only the specified binary:
cargo build --bin name
# Build only the specified test target:
cargo build --test testname
